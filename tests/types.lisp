(in-package :format-ansi/tests)

(lt:define-test ansi-entry-ok (type-checking)
  (assert (ansi-entry? ""))
  (assert (ansi-entry? '("")))
  (assert (ansi-entry? '(:fg :red "")))
  (assert (ansi-entry? '(:bg :red "")))
  (assert (ansi-entry? '(:st :bold "")))
  (assert (ansi-entry? '(:st :bold :fg :blue "with arg: ~A" 1)))
  (assert (ansi-entry? '("with args: ~A + ~A" "foo" #\B))))

(lt:define-test ansi-entry-not-ok (type-checking)
  (assert (not (ansi-entry? nil)))
  (assert (not (ansi-entry? '(:fg))))
  (assert (not (ansi-entry? '(:fg :red))))
  (assert (not (ansi-entry? '(:fg :bold ""))))
  (assert (not (ansi-entry? '(:st :red "")))))

(lt:define-test ansi-entries-ok (type-checking)
  (assert (ansi-entries? nil))
  (assert (ansi-entries? '((""))))
  (assert (ansi-entries? '((:fg :red "")))))

(lt:define-test ansi-entries-not-ok (type-checking)
  (assert (not (ansi-entries? 1)))
  (assert (not (ansi-entries? "")))
  (assert (not (ansi-entries? '("" :fg :red)))))
